<odoo>
    <data>
        <!-- Admission Form View -->
        <record id="view_admission_form" model="ir.ui.view">
            <field name="name">gssc.admission.form</field>
            <field name="model">gssc_admission</field>
            <field name="arch" type="xml">
                <form string="Admission Form">
                    <sheet>
                        <group>
                            <field name="name" placeholder="Enter your name" required="1"/>
                            <field name="email" placeholder="Enter your email" required="1"/>
                            <field name="phone" placeholder="Enter your phone number" required="1"/>
                            <field name="course" placeholder="Select your course" required="1"/>
                            <field name="batch" placeholder="Select your batch" required="1"/>
                            <field name="dob" placeholder="Enter your date of birth" required="1"/>
                        </group>
                        <footer>
                            <button type="submit" string="Submit" class="btn btn-primary"/>
                            <button type="button" string="Cancel" class="btn btn-secondary"
                                    onclick="window.location.href='/';"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to open the form -->
        <record id="action_admission_form" model="ir.actions.act_window">
            <field name="name">Admission Form</field>
            <field name="res_model">gssc_admission</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_admission_form"/>
            <field name="target">new</field>
        </record>

        <!-- Menu item to access the form -->
        <record id="menu_admission_form" model="ir.ui.menu">
            <field name="name">Admission Form</field>
            <field name="parent_id" ref="base.menu_custom"/>
            <field name="action" ref="action_admission_form"/>
        </record>
    </data>
</odoo>
